# ── Persistence ───────────────────────────────────────────────────────────────
# Leave empty to use the local JSON store (great for local dev / single VPS).
# Set both to keep data on serverless hosts (Vercel, Netlify, ...).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: real transcription & rendering ─────────────────────────────────
# Captions are fetched from YouTube automatically; these only override defaults.
# A static ffmpeg is bundled with the app, so this is usually unnecessary.
YTDLP_PATH=
FFMPEG_PATH=
# Cookie header from a signed-in YouTube session — unlocks MP4 export on videos
# that bot-check the server. Never commit a real value.
YOUTUBE_COOKIE=
# Bucket for rendered MP4s (created by supabase/schema.sql).
SUPABASE_RENDER_BUCKET=clipforge-renders

# ── Optional: LLM polish for titles & hooks ──────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Ops ──────────────────────────────────────────────────────────────────────
# Gate for GET /api/diag (host reachability probe).
DIAG_KEY=
