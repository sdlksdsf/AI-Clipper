# ── Persistence ───────────────────────────────────────────────────────────────
# Leave empty to use the local JSON store (great for local dev / single VPS).
# Set both to keep data on serverless hosts (Vercel, Netlify, ...).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: real transcription & rendering ─────────────────────────────────
# Any one of these turns on real caption fetching when the host allows network.
# yt-dlp / ffmpeg binaries are auto-detected on the host.
YTDLP_PATH=
FFMPEG_PATH=

# ── Optional: LLM polish for titles & hooks ──────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
